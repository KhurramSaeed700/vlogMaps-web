# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Mapbox
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN is required by browser map components.
# MAPBOX_ACCESS_TOKEN is required by server-side proxy routes. Use a restricted server token.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
MAPBOX_ACCESS_TOKEN=

# YouTube Data API
YOUTUBE_DATA_API_KEY=

# Neon / Postgres persistence for Prisma and creator video/editor state
DATABASE_URL=

# Sentry monitoring (DSN is public; auth token is build-only and must stay secret)
NEXT_PUBLIC_SENTRY_DSN=
# Unset: production only. false: pause everywhere. true: opt in during local testing.
NEXT_PUBLIC_SENTRY_ENABLED=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Optional masked replay; no routine sessions, at most 10% of error sessions
NEXT_PUBLIC_SENTRY_REPLAY_ENABLED=false
